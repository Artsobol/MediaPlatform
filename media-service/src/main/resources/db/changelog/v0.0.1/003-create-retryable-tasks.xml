<?xml version="1.0" encoding="UTF-8" ?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20260730" author="artsobol">
        <createTable tableName="retryable_tasks">
            <column name="id" type="uuid">
                <constraints primaryKey="true" primaryKeyName="pk_retryable_tasks"/>
            </column>
            <column name="payload" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="type" type="varchar(128)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="varchar(128)">
                <constraints nullable="false"/>
            </column>
            <column name="retry_time" type="timestamptz">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamptz" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamptz" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="retryable_tasks" indexName="idx_retryable_tasks_processing">
            <column name="type"/>
            <column name="status"/>
            <column name="retry_time"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>